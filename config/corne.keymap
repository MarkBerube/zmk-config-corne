#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {

        behaviors {

                hm: homerow_mods {
                    compatible = "zmk,behavior-hold-tap";
                    #binding-cells = <2>;
                    tapping-term-ms = <200>;
                    quick-tap-ms = <0>;
                    flavor = "tap-preferred";
                    bindings = <&kp>, <&kp>;
                };

                nav_thumb: navigation_thumb {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        tapping-term-ms = <180>;
                        flavor = "hold-preferred";
                        bindings = <&mo>, <&kp>;
                };

                layer_thumb: layer_thumb_behavior {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        tapping-term-ms = <180>;
                        flavor = "hold-preferred";
                        bindings = <&mo>, <&tog>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Base";
                        bindings = <
                            &kp TAB          &kp Q            &kp W            &kp E            &kp R            &kp T    &kp Y            &kp U            &kp I            &kp O            &kp P            &kp BSPC
                            &kp LCTRL         &hm RGUI A       &hm LALT S       &kp D            &kp F      &kp G    &kp H            &kp J      &kp K            &hm RALT L       &hm RGUI SEMI    &kp SQT
                            &kp LSHFT        &kp Z            &kp X            &kp C            &kp V            &kp B    &kp N            &kp M            &kp COMMA        &kp DOT          &kp FSLH         &kp RSHFT
                                                                               &nav_thumb 2 ESC &kp BSPC         &layer_thumb 5 5    &kp RET          &kp SPACE        &layer_thumb 3 1
                        >;
                };

                keypad_layer {
                        display-name = "Keypad";
                        bindings = <
                            &trans           &trans           &trans           &trans           &trans           &trans    &kp KP_DIVIDE    &kp KP_N7        &kp KP_N8        &kp KP_N9        &kp KP_MINUS     &kp KP_MULTIPLY
                            &trans           &trans           &trans           &trans           &trans           &trans    &kp KP_DOT           &kp KP_N4        &kp KP_N5        &kp KP_N6        &kp KP_PLUS      &kp KP_NUM
                            &trans           &trans           &trans           &trans           &trans           &trans    &kp KP_N0        &kp KP_N1        &kp KP_N2        &kp KP_N3        &kp KP_ENTER     &trans
                                                                               &trans           &trans           &trans    &trans           &trans           &trans
                        >;
                };

                nav_layer {
                        display-name = "Nav";
                        bindings = <
                            &trans           &kp HOME         &kp END          &kp PG_UP        &kp PG_DN        &kp INS    &trans           &trans           &trans           &trans           &trans           &trans
                            &kp LCTRL        &trans           &trans           &trans           &trans           &trans    &trans           &trans           &trans           &trans           &trans           &trans
                            &trans           &trans           &trans           &trans           &kp LEFT         &kp RIGHT    &kp UP           &kp DOWN         &trans           &trans           &mo 4            &trans
                                                                               &trans           &trans           &trans    &trans           &trans           &trans
                        >;
                };

                numbers_layer {
                        display-name = "Numbers / F-keys";
                        bindings = <
                            &kp EQUAL        &kp N1           &kp N2           &kp N3           &kp N4           &kp N5    &kp N6           &kp N7           &kp N8           &kp N9           &kp N0           &kp MINUS
                            &kp F1           &kp F2           &kp F3           &kp F4           &kp F5           &kp F6    &kp F7           &kp F8           &kp F9           &kp F10          &kp F11          &kp F12
                            &trans           &trans           &trans           &trans           &trans           &trans    &trans           &trans           &trans           &trans           &trans           &trans
                                                                               &trans           &trans           &trans    &trans           &trans           &trans
                        >;
                };

                bluetooth_layer {
                        display-name = "Bluetooth";
                        bindings = <
                            &trans           &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_CLR    &trans           &trans           &trans           &trans           &trans           &trans
                            &trans           &trans           &trans           &trans           &trans           &trans    &trans           &trans           &trans           &trans           &trans           &trans
                            &trans           &trans           &trans           &trans           &trans           &trans    &trans           &trans           &trans           &trans           &trans           &trans
                                                                               &trans           &trans           &trans    &trans           &trans           &trans
                        >;
                };

                code_layer {
                        display-name = "Code";
                        bindings = <
                            &trans           &kp K_APP        &kp PG_DN        &kp PG_UP        &kp HOME         &trans    &kp GRAVE        &kp LBKT         &kp RBKT         &kp LT           &kp GT           &kp PIPE
                            &trans           &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &kp ESC    &kp TILDE        &kp LPAR         &kp RPAR         &kp MINUS        &trans           &trans
                            &trans           &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_CLR    &trans           &kp LBRC         &kp RBRC         &kp UNDER        &kp BSLH         &trans
                                                                               &trans           &trans           &trans    &trans           &trans           &trans
                        >;
                };
        };
};
